{
  "name": "@guardian/simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p web && vite build web",
    "dev": "tsx watch --exclude ./web src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "express": "^5.3.0",
    "vite": "^6.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/express": "^5.0.6"
  }
}
